# Provider keys, read by the gateway adapters (step 3 onward). Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Where the served gateway writes its request log (SQLite). Optional.
LLM_GATEWAY_LOG=var/requests.sqlite3
# Routing config for "model": "auto". Optional; defaults to llm_gateway/routing.yaml.
LLM_GATEWAY_ROUTING=llm_gateway/routing.yaml

# Slice 3: shared health, breaker state and the deferrable queue.
LLM_GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
# Grafana admin password for the local compose stack (anonymous viewing is on).
GRAFANA_ADMIN_PASSWORD=
